{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "rude-bot",
  "main": "src/main.ts",
  "compatibility_date": "2026-07-23",
  "rules": [
    { "type": "Data", "globs": ["**/*.jpg"], "fallthrough": true }
  ],
  "durable_objects": {
    "bindings": [
      { "name": "BEEN_COUNTER", "class_name": "BeenCounter" },
      { "name": "BEAN_COUNTER", "class_name": "BeanCounter" },
      { "name": "SPANK_CHAIN", "class_name": "SpankChain" },
      { "name": "WORDLE_GOLF", "class_name": "WordleGolf" },
      { "name": "WORDLE_GOLF_REGISTRY", "class_name": "WordleGolfRegistry" },
      { "name": "STOCK_MARKET", "class_name": "StockMarket" },
      { "name": "STOCK_MARKET_REGISTRY", "class_name": "StockMarketRegistry" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["BeenCounter"] },
    { "tag": "v2", "new_sqlite_classes": ["SpankChain"] },
    { "tag": "v3", "new_sqlite_classes": ["WordleGolf"] },
    { "tag": "v4", "new_sqlite_classes": ["WordleGolfRegistry"] },
    { "tag": "v5", "new_sqlite_classes": ["StockMarket", "StockMarketRegistry"] },
    { "tag": "v6", "new_sqlite_classes": ["BeanCounter"] }
  ],
  // Cron Triggers always run in UTC (no timezone support), so both of these drift an hour across DST —
  // 13:00 UTC is 9am US/Eastern during EDT (summer); it'll land at 8am during EST (winter).
  // Daily: Wordle Golf's reminder/finalize sweep + the stock market's daily price decay.
  // Weekly (Monday): the stock market's cash allowance.
  "triggers": {
    "crons": ["0 13 * * *", "0 13 * * 1"]
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "persist": true,
      "invocation_logs": true
    },
    "traces": {
      "enabled": false,
      "persist": true,
      "head_sampling_rate": 1
    }
  }
}
