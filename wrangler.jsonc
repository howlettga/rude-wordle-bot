{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "rude-bot",
  "main": "src/main.ts",
  "compatibility_date": "2026-07-23",
  "rules": [
    { "type": "Data", "globs": ["**/*.jpg"], "fallthrough": true }
  ],
  "durable_objects": {
    "bindings": [
      { "name": "BEEN_COUNTER", "class_name": "BeenCounter" },
      { "name": "BEAN_COUNTER", "class_name": "BeanCounter" },
      { "name": "SPANK_CHAIN", "class_name": "SpankChain" },
      { "name": "WORDLE_GOLF", "class_name": "WordleGolf" },
      { "name": "WORDLE_GOLF_REGISTRY", "class_name": "WordleGolfRegistry" },
      { "name": "STOCK_MARKET", "class_name": "StockMarket" },
      { "name": "STOCK_MARKET_REGISTRY", "class_name": "StockMarketRegistry" },
      { "name": "CHAT_PAUSE", "class_name": "ChatPause" },
      { "name": "RUDE_MESSAGES", "class_name": "RudeMessages" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["BeenCounter"] },
    { "tag": "v2", "new_sqlite_classes": ["SpankChain"] },
    { "tag": "v3", "new_sqlite_classes": ["WordleGolf"] },
    { "tag": "v4", "new_sqlite_classes": ["WordleGolfRegistry"] },
    { "tag": "v5", "new_sqlite_classes": ["StockMarket", "StockMarketRegistry"] },
    { "tag": "v6", "new_sqlite_classes": ["BeanCounter"] },
    { "tag": "v7", "new_sqlite_classes": ["ChatPause"] },
    { "tag": "v8", "new_sqlite_classes": ["RudeMessages"] }
  ],
  // Cron Triggers always run in UTC (no timezone support), and every job is scheduled in Eastern time,
  // which shifts against UTC across DST. So this is one hourly trigger, and main.ts's scheduled() checks
  // the Eastern hour and runs whatever's due:
  // Midnight ET: Wordle Golf's reminder/finalize sweep + the stock market's daily price decay, plus the
  // weekly cash allowance on Mondays.
  // 8am ET: the stock market's trading-halt roll/announcement + daily data purge.
  // 5pm ET: long-call options settlement.
  "triggers": {
    "crons": ["0 * * * *"]
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "persist": true,
      "invocation_logs": true
    },
    "traces": {
      "enabled": false,
      "persist": true,
      "head_sampling_rate": 1
    }
  }
}
